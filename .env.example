# Appwrite (desenvolvimento local)
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=medcuidar
APPWRITE_DATABASE_ID=medcuidar
# Chave de API com escopos de banco, usuarios, times e storage. Nunca commitar o valor real.
APPWRITE_API_KEY=

# WhatsApp: canal escolhido por configuracao (evolution-go | meta-cloud). Preencher quando o numero existir.
# fake = só desenvolvimento/e2e (grava em FAKE_CHANNEL_FILE; recusado em produção)
CHANNEL_PROVIDER=evolution-go
# Evolution Go (https://docs.evolutionfoundation.com.br/evolution-go)
EVOLUTION_BASE_URL=
# GLOBAL_API_KEY do Evolution Go (cabecalho apikey)
EVOLUTION_API_KEY=
# UUID da instancia (cabecalho instanceId)
EVOLUTION_INSTANCE_ID=
# Botoes interativos reais. Padrao false: opcoes numeradas em texto ("Responda 1 para Tomei").
# So ligue com a API oficial da Meta; em conexoes nao oficiais os botoes somem sem aviso.
SUPPORTS_BUTTONS=false
# Meta Cloud (so se CHANNEL_PROVIDER=meta-cloud)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Segredo compartilhado N8N <-> Function whatsapp-inbound (cabecalho x-medcuidar-secret)
WHATSAPP_WEBHOOK_SECRET=
# Segredo para hashear/selar o codigo de login por WhatsApp (gere um valor aleatorio longo)
LOGIN_CODE_SECRET=

# Transcricao de audio: gemini (padrao) ou n8n
TRANSCRIPTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TRANSCRIPTION_N8N_URL=

# Monitoramento e alertas operacionais
# URL de push do monitor externo (Uptime Kuma / Healthchecks): se o ping parar, ele avisa
HEARTBEAT_URL=
# Webhook "medcuidar-alertas" do N8N e seu segredo
ALERTS_WEBHOOK_URL=
ALERTS_WEBHOOK_SECRET=
# Segredo para disparar a Function scheduler por HTTP (reserva pelo N8N)
SCHEDULER_TRIGGER_SECRET=

# Smoke test do canal (pnpm --filter @medcuidar/channels smoke): SEMPRE um numero de teste
SMOKE_TO=
# O envio real so acontece com SMOKE_CONFIRM=ENVIAR
SMOKE_CONFIRM=
SMOKE_GROUP_ID=
SMOKE_MEDIA_URL=

# Lote 3 — receitas. Bucket PRIVADO do Appwrite (file security ligada, sem permissão pública); o portal não o cria:
# passo a passo em docs/09-deploy-staging.md, seção 11. A chave APPWRITE_API_KEY precisa de files.read, files.write e buckets.read.
APPWRITE_PRESCRIPTIONS_BUCKET_ID=prescriptions
# Segredo (32+ letras e números aleatórios) que assina os links de 10 minutos das páginas das receitas (/api/rx-file). Nunca commitar o valor real.
FILE_URL_SECRET=
# Só testes automáticos: RX_STORAGE=memory guarda as páginas na memória do servidor de teste (exige E2E_TEST_MODE=1; recusado em produção).
# RX_STORAGE=

# ---- Postgres v2 (docs/06, docs/07) ----
# Banco local: pnpm db:up (docker-compose.dev.yml, porta 5440). Valores de exemplo SEM segredo real;
# em producao use senhas proprias, so em variaveis de ambiente.
# Papel da APLICACAO (sem BYPASSRLS): portal e API.
DATABASE_URL=postgres://medcuidar_app:medcuidar_app_dev@localhost:5440/medcuidar
# Papel de MIGRACAO/dono: so migrate, seed e testes. Nunca na aplicacao.
DATABASE_URL_ADMIN=postgres://medcuidar_owner:medcuidar_owner_dev@localhost:5440/medcuidar
# Opcionais do docker-compose.dev.yml (valem so na criacao do volume)
# POSTGRES_PORT=5440
# APP_DB_PASSWORD=medcuidar_app_dev
# OWNER_DB_PASSWORD=medcuidar_owner_dev

# ---- Portal Lote 1 (apps/web): acesso e cadastros (docs/09-deploy-staging.md) ----
# postgres = portal real (Postgres + login do Appwrite). mock = dados fictícios, sem login (só desenvolvimento).
DATA_SOURCE=postgres
# Endereço público do portal, sem barra no fim; vai nos links dos e-mails (verificação, senha, convite).
# Local: http://localhost:3000. Staging: https://automacoes-app-controle-remedios.8m5sgi.easypanel.host
# Precisa estar cadastrado como "plataforma web" no projeto do Appwrite.
APP_URL=http://localhost:3000
# production no staging/produção (recusa rotas e modo de teste).
APP_ENV=
# Appwrite só para login (e-mail/senha): APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID e APPWRITE_API_KEY acima.
# Escopos mínimos da chave no Lote 1: users.read, users.write, sessions.write.
# APPWRITE_DATABASE_ID acima só vale para o legado (Appwrite Databases) e sai nos próximos lotes.

# ---- Só testes automáticos (nunca no staging) ----
# 1 = e2e: não envia e-mail de convite (o link é lido de /api/test/invite-link). Recusado com APP_ENV=production.
E2E_TEST_MODE=
# Porta do e2e (padrão 3100) e navegador (padrão msedge)
# E2E_PORT=3100
# E2E_BROWSER_CHANNEL=msedge

# ---- Lote 4A — API /api/v1, validação do número e simulador de WhatsApp (docs/09 seção 12, docs/10) ----
# APP_URL (já existe) também monta o link de primeiro acesso do convite por WhatsApp: obrigatória, sem valor padrão.
# 1 liga o Simulador de WhatsApp (Configurações › Simulador, só Administrador). SÓ no staging; não defina em produção.
# SIMULATOR_ENABLED=
# true só com a API oficial da Meta (botões). Padrão: opções numeradas em texto.
# SUPPORTS_BUTTONS=false
# 1 deixa o Administrador criar a chave cpl_ do N8N pelo portal (Lote 4B). Padrão: desligado.
# PLATFORM_KEYS_FROM_PORTAL=

# ---- Lote 4B: N8N e WhatsApp (docs/11-n8n-whatsapp.md) ----
# Nada de URL/chave do N8N ou da Evolution Go aqui: ficam no N8N (nos de Config e Credenciais) e, no portal, em Configuracoes > WhatsApp.
# O segredo do teste de conexao e guardado cifrado com FILE_URL_SECRET (se trocar a FILE_URL_SECRET, gere o segredo de novo).
# So testes automaticos (e2e/integracao): libera localhost no teste de conexao. Recusada com APP_ENV=production. NUNCA no staging/producao.
# ALLOW_PRIVATE_WEBHOOKS=
