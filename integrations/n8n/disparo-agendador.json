{
  "name": "MedCuidar — Disparo do agendador (reserva do cron do Appwrite)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] } },
      "id": "d4000000-0000-4000-8000-000000000001",
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCHEDULER_FUNCTION_URL }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-medcuidar-secret", "value": "={{ $env.SCHEDULER_TRIGGER_SECRET }}" }] },
        "options": { "timeout": 50000 }
      },
      "id": "d4000000-0000-4000-8000-000000000002",
      "name": "Chamar scheduler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": { "A cada minuto": { "main": [[{ "node": "Chamar scheduler", "type": "main", "index": 0 }]] } },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none" },
  "active": false,
  "pinData": {},
  "tags": [{ "name": "medcuidar" }]
