{
  "name": "MedCuidar — Alertas operacionais ao administrador",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "medcuidar-alertas", "authentication": "headerAuth", "responseMode": "onReceived", "options": {} },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Webhook alertas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "medcuidar-alertas",
      "credentials": { "httpHeaderAuth": { "id": "CONFIGURAR", "name": "MedCuidar Alertas" } }
    },
    {
      "parameters": {
        "jsCode": "// Só ids e contagens chegam aqui (sem telefone, nome ou texto de mensagem).\nconst e = $input.first().json.body || {};\nconst titles = {\n  outbox_dead: 'Mensagem desistida (dead) na fila',\n  provider_down: 'WhatsApp (Evolution Go) fora do ar',\n  scheduler_error: 'Falha no agendador',\n  scheduler_stalled: 'Agendador parado',\n  inbound_error: 'Falha ao processar mensagem recebida',\n};\nconst subject = '[MedCuidar] ' + (titles[e.kind] || 'Alerta operacional');\nconst lines = Object.entries(e.details || {}).map(([k, v]) => k + ': ' + v);\nreturn [{ json: { subject, text: [subject, ...lines, 'Quando: ' + (e.at || '')].join('\\n') } }];"
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Montar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fromEmail": "medcuidar@TROQUE-PELO-SEU-DOMINIO.com.br",
        "toEmail": "admin@TROQUE-PELO-SEU-DOMINIO.com.br",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "E-mail ao administrador",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [440, 0],
      "credentials": { "smtp": { "id": "CONFIGURAR", "name": "SMTP MedCuidar" } }
    }
  ],
  "connections": {
    "Webhook alertas": { "main": [[{ "node": "Montar aviso", "type": "main", "index": 0 }]] },
    "Montar aviso": { "main": [[{ "node": "E-mail ao administrador", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "tags": [{ "name": "medcuidar" }]
}
