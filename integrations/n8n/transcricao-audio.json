{
  "name": "MedCuidar — Transcrição de áudio (Gemini)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "medcuidar-transcrever", "authentication": "headerAuth", "responseMode": "lastNode", "options": {} },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Webhook transcrever",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "medcuidar-transcrever",
      "credentials": { "httpHeaderAuth": { "id": "CONFIGURAR", "name": "MedCuidar Alertas" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contents: [{ parts: [{ text: 'Transcreva fielmente este áudio em pt-BR. Responda só com a transcrição.' }, { inlineData: { mimeType: ($json.body.mimeType || 'audio/ogg').split(';')[0], data: $json.body.audioBase64 } }] }], generationConfig: { temperature: 0 } } }}",
        "options": { "timeout": 30000 }
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "credentials": { "httpHeaderAuth": { "id": "CONFIGURAR", "name": "Gemini API Key" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "text",
              "type": "string",
              "value": "={{ ($json.candidates?.[0]?.content?.parts || []).map(p => p.text || '').join('').trim() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Só o texto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Webhook transcrever": { "main": [[{ "node": "Gemini", "type": "main", "index": 0 }]] },
    "Gemini": { "main": [[{ "node": "Só o texto", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none" },
  "active": false,
  "pinData": {},
  "tags": [{ "name": "medcuidar" }]
}
