{
  "name": "medcuidar",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @medcuidar/pg generate",
    "db:migrate": "pnpm --filter @medcuidar/pg migrate",
    "db:seed": "pnpm --filter @medcuidar/pg seed",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:test": "pnpm --filter @medcuidar/pg test",
    "n8n:build": "pnpm --filter @medcuidar/n8n build",
    "n8n:validar": "pnpm --filter @medcuidar/n8n validar"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
